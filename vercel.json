{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/submit-plan.ts": {
      "includeFiles": "api/_lib/**"
    },
    "api/submit-free-design.ts": {
      "includeFiles": "api/_lib/**"
    },
    "api/submit-contact.ts": {
      "includeFiles": "api/_lib/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
