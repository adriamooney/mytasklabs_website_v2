{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/submit-plan.ts": {
      "includeFiles": "api/_lib/**"
    },
    "api/submit-free-design.ts": {
      "includeFiles": "api/_lib/**"
    },
    "api/submit-contact.ts": {
      "includeFiles": "api/_lib/**"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/$1" }]
}
