# Resend — LocalLift (/api/submit-free-design) + Contact (/api/submit-contact)
# https://resend.com — verify domain; same key/from for both routes
RESEND_API_KEY=
RESEND_FROM=My Task Labs <notifications@yourdomain.com>
LOCALIFT_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=

# Monday.com (Custom plan leads)
# Get token from Monday.com → Profile → Develop → API token
# Board/column IDs from API: query { boards(ids: [BOARD_ID]) { groups { id } columns { id title } } }
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=topics
MONDAY_COLUMN_EMAIL=
MONDAY_COLUMN_LEAD_DATA=

# EmailJS (Plan delivery email - server-side only; /api/submit-plan)
# Private key required when "Allow non-browser" is enabled (strict mode)
# Get from https://dashboard.emailjs.com/admin/account
EMAILJS_QUIZ_PUBLIC_KEY=
EMAILJS_QUIZ_SERVICE_ID=
EMAILJS_QUIZ_TEMPLATE_ID=
EMAILJS_QUIZ_PRIVATE_KEY=
